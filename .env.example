# ==========================================================
# VisionSense AI CCTV Retail Analytics Platform Configuration
# ==========================================================

# --- Supabase PostgreSQL Database (Optional / Free Cloud DB) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key

# --- YOLO Detection & Device Configuration ---
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
YOLO_IMGSZ=512
DEVICE=auto
USE_GPU=true

# --- 4-Camera Video / RTSP Feeds ---
# Local video files: data/videos/camera1.mp4 or videos/camera1.mp4
# RTSP streams: rtsp://admin:password@192.168.1.100:554/stream1
# USB Webcams: 0, 1, 2
CAMERA1_SOURCE=data/videos/camera1.mp4
CAMERA2_SOURCE=data/videos/camera2.mp4
CAMERA3_SOURCE=data/videos/camera3.mp4
CAMERA4_SOURCE=data/videos/camera4.mp4

# --- Multi-Object Tracker ---
TRACKER=bytetrack
TRACK_TIMEOUT_SECONDS=3.0
LOST_TIMEOUT_SECONDS=5.0

# --- Person Re-Identification (Cross-Camera Global IDs) ---
ENABLE_REID=false
REID_SIMILARITY_THRESHOLD=0.75

# --- Visual Overlays & Analytics ---
HEATMAP_ENABLED=true
TRAIL_ENABLED=true
TRAIL_LENGTH=50

# --- Database Sync & Aggregation ---
DATABASE_BATCH_INTERVAL=10
